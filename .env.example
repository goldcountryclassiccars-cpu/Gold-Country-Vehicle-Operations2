# Copy this file to .env and adjust values for your environment.
# Never commit .env to source control.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://gccc:gccc_dev_password@localhost:5432/gccc_ops"
# Direct (unpooled) connection used only by migrations. In development this is
# the same as DATABASE_URL; on a serverless host DATABASE_URL points at the
# connection pooler and this one points at the database directly.
DIRECT_URL="postgresql://gccc:gccc_dev_password@localhost:5432/gccc_ops"

# Session cookie signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="change-me-generate-a-long-random-value"

# Application base URL
APP_URL="http://localhost:3000"

# File storage adapter: "local" (development) or "s3" (production, not yet configured)
STORAGE_ADAPTER="local"
STORAGE_LOCAL_DIR="./storage"

# S3-compatible storage (required when STORAGE_ADAPTER="s3").
# Works with Supabase Storage, Cloudflare R2, MinIO or AWS S3.
# S3_ENDPOINT="https://<project>.supabase.co/storage/v1/s3"
# S3_BUCKET="gccc-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# Path-style addressing; "true" for Supabase/MinIO, "false" for AWS S3.
# S3_FORCE_PATH_STYLE="true"

# Email adapter: "log" (development — logs messages, sends nothing) or "smtp" (production)
EMAIL_ADAPTER="log"
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
EMAIL_FROM="ops@goldcountryclassiccars.example"

# E-signature adapter: "mock" (development) — real provider adapters are future work
ESIGN_ADAPTER="mock"

# Listing integration API key used by the future listing application to call this app's API.
# Generate with: openssl rand -hex 32
LISTING_API_KEY="dev-listing-api-key"

# Session lifetime in hours
SESSION_TTL_HOURS="12"
