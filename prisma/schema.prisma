// GCCC Ops — Prisma schema
// Phase 1: authentication, users, roles, permissions, departments, audit, settings.
// Later phases extend this schema via versioned migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users and authentication
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  phone               String?
  passwordHash        String
  active              Boolean   @default(true)
  mfaEnrolled         Boolean   @default(false)
  defaultLandingPage  String?
  notificationPrefs   Json      @default("{}")
  primaryDepartment   Department? @relation("PrimaryDepartment", fields: [primaryDepartmentId], references: [id])
  primaryDepartmentId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastLoginAt         DateTime?

  roles       UserRole[]
  departments UserDepartment[]
  sessions    Session[]
  auditEvents AuditEvent[] @relation("AuditActor")
}

model Session {
  id             String   @id @default(uuid())
  tokenHash      String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  ip             String?
  userAgent      String?
  // Owner "Preview as Role" state. Null when not previewing. The real user and
  // roles remain authoritative for auditing; preview only narrows the UI/reads.
  previewRoleKey String?

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Roles and permissions (data-driven RBAC + record scopes + field grants)
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "owner", "mechanic"
  name        String
  description String?
  // System roles are seeded and cannot be deleted (but grants remain editable,
  // except the owner role which is locked to full access).
  isSystem    Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]
  fieldGrants RoleFieldGrant[]
}

model UserRole {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@id([userId, roleId])
}

enum PermissionScope {
  ALL // every record
  DEPARTMENT // records associated with the user's department(s)
  ASSIGNED // records assigned to the user (or the user's vendor party)
  OWN // records created by the user
  NONE // no access (explicit deny marker; absence of a row also means none)
}

// One row per (role, resource, action): "mechanic may VIEW work_orders at ASSIGNED scope".
// Resources and actions are string keys defined centrally in src/lib/authz/registry.ts.
model RolePermission {
  id       String          @id @default(uuid())
  role     Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId   String
  resource String
  action   String
  scope    PermissionScope

  @@unique([roleId, resource, action])
  @@index([resource])
}

// Grants a role visibility of a protected field category
// (e.g. "acquisition_cost", "profit", "consignor_payout", "buyer_pii").
model RoleFieldGrant {
  id       String @id @default(uuid())
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId   String
  fieldKey String

  @@unique([roleId, fieldKey])
}

// ---------------------------------------------------------------------------
// Departments
// ---------------------------------------------------------------------------

model Department {
  id     String  @id @default(uuid())
  key    String  @unique // e.g. "mechanical", "detailing", "body", "media", "sales", "finance", "transport", "operations"
  name   String
  active Boolean @default(true)

  users        UserDepartment[]
  primaryUsers User[]           @relation("PrimaryDepartment")
}

model UserDepartment {
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String

  @@id([userId, departmentId])
}

// ---------------------------------------------------------------------------
// Audit (append-oriented; rows are never updated or deleted by the app)
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(uuid())
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId        String?
  actorName      String // denormalized so history survives user changes
  actingRoles    String // comma-separated role keys at time of action
  action         String // e.g. "auth.login", "vehicle.update", "release.override"
  resourceType   String?
  resourceId     String?
  previousValues Json?
  newValues      Json?
  reason         String?
  source         String   @default("web") // web | api | system | integration
  integration    String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Application settings (dealership configuration; secrets stay in env vars)
// ---------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ===========================================================================
// Phase 2 — vehicle domain: files, parties, vehicles, identifiers, episodes,
// statuses, arrangements, locations, related items, intake
// ===========================================================================

// ---------------------------------------------------------------------------
// Files (storage abstraction metadata — private by default)
// ---------------------------------------------------------------------------

model FileObject {
  id           String   @id @default(uuid())
  storageKey   String   @unique // adapter-specific key; never a public URL
  adapter      String // "local" | "s3"
  originalName String
  contentType  String
  sizeBytes    Int
  sha256       String?
  uploadedBy   String? // userId
  createdAt    DateTime @default(now())
  // Sensitive files (titles, signed docs, IDs) get a sensitivity key that maps
  // to a field grant checked before any download.
  sensitivity  String? // e.g. "title_docs", "signed_docs", "id_docs"
}

// ---------------------------------------------------------------------------
// Parties (people and organizations, reused across modules)
// ---------------------------------------------------------------------------

enum PartyKind {
  PERSON
  ORGANIZATION
}

model Party {
  id           String    @id @default(uuid())
  kind         PartyKind
  displayName  String
  firstName    String?
  lastName     String?
  organization String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?   @default("US")
  notes        String?
  // Distinguishes vendor/carrier parties that can hold restricted user accounts
  isVendor     Boolean   @default(false)
  isCarrier    Boolean   @default(false)
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?
}

// ---------------------------------------------------------------------------
// Vehicle (permanent identity)
// ---------------------------------------------------------------------------

enum MileageStatus {
  ACTUAL
  EXEMPT
  NOT_ACTUAL
  TMU // true mileage unknown
  BROKEN_ODOMETER
  UNKNOWN
}

model Vehicle {
  id                    String        @id @default(uuid())
  year                  Int?
  make                  String
  model                 String
  trim                  String?
  bodyStyle             String?
  exteriorColor         String?
  interiorColor         String?
  engineDescription     String?
  transmission          String?
  drivetrain            String?
  mileage               Int?
  mileageStatus         MileageStatus @default(UNKNOWN)
  titleBrand            String?
  buildDate             String?
  matchingNumbers       String? // "yes" | "no" | "partial" | "unverified"
  originalityNotes      String?
  modifications         String?
  restorationHistory    String?
  provenance            String?
  generalDescription    String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  identifiers VehicleIdentifier[]
  episodes    InventoryEpisode[]
}

enum IdentifierType {
  VIN
  SHORT_VIN
  CHASSIS_NUMBER
  SERIAL_NUMBER
  ENGINE_NUMBER
  BODY_NUMBER
  COWL_TAG
  OTHER
  UNKNOWN_PENDING
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  MISMATCH
}

// No length constraint anywhere — classic cars have short, nonstandard IDs.
model VehicleIdentifier {
  id           String             @id @default(uuid())
  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId    String
  type         IdentifierType
  value        String
  isPrimary    Boolean            @default(false)
  verification VerificationStatus @default(UNVERIFIED)
  verifiedById String?
  verifiedAt   DateTime?
  notes        String?
  photoFileId  String?
  createdAt    DateTime           @default(now())

  @@index([vehicleId])
  @@index([value])
}

// ---------------------------------------------------------------------------
// Inventory episode (one period of possession/marketing) + parallel statuses
// ---------------------------------------------------------------------------

enum DealType {
  DEALER_PURCHASE
  CONSIGNMENT
  BROKERAGE
  OTHER
}

enum CustodyStatus {
  EXPECTED
  INBOUND_TRANSPORT
  ON_SITE
  DETAIL_AREA
  MECHANICAL_AREA
  BODY_SHOP
  MEDIA_AREA
  OFFSITE_VENDOR
  AUTOMOTIVE_EVENT
  TEST_DRIVE
  TRANSPORT_STAGING
  CARRIER_POSSESSION
  DELIVERED
  RETURNED_TO_CONSIGNOR
}

enum ReconditioningStatus {
  NOT_ASSESSED
  INSPECTION_SCHEDULED
  INSPECTION_IN_PROGRESS
  AWAITING_ESTIMATE
  AWAITING_APPROVAL
  AWAITING_CONSIGNOR_APPROVAL
  AWAITING_PARTS
  WORK_IN_PROGRESS
  QUALITY_CONTROL
  COMPLETE
  WORK_DECLINED
  NO_WORK_REQUIRED
}

enum MarketingStatus {
  NOT_READY
  MEDIA_PENDING
  MEDIA_IN_PROGRESS
  LISTING_PACKAGE_INCOMPLETE
  READY_FOR_LISTING
  SUBMITTED_TO_LISTING_SYSTEM
  LIVE
  PAUSED
  WITHDRAWN
  MARKED_SOLD
}

enum SalesStatus {
  AVAILABLE
  INQUIRY_ACTIVITY
  HOLD
  DEPOSIT_REQUESTED
  DEPOSIT_RECEIVED
  CONTRACTED
  FUNDS_PENDING
  FUNDED
  READY_FOR_RELEASE
  RELEASED
  DELIVERED
  CANCELED
  UNWOUND
}

enum DocStatus {
  NOT_STARTED
  MISSING_SELLER_DOCUMENTS
  MISSING_BUYER_DATA
  READY_TO_GENERATE
  GENERATED
  SENT
  PARTIALLY_SIGNED
  ESIGN_COMPLETE
  ORIGINALS_PENDING
  COMPLETE
  FILED
}

enum FinancialCloseStatus {
  ESTIMATING
  EXPENSES_INCOMPLETE
  BUYER_FUNDS_PENDING
  BUYER_FUNDED
  CONSIGNOR_PAYABLE
  PAYOUT_APPROVAL_PENDING
  PAYOUT_COMPLETE
  FINAL_RECONCILIATION_PENDING
  FINANCIALLY_CLOSED
}

model AcquisitionSource {
  id     String  @id @default(uuid())
  key    String  @unique
  name   String
  active Boolean @default(true)
}

model InventoryEpisode {
  id                   String               @id @default(uuid())
  vehicle              Vehicle              @relation(fields: [vehicleId], references: [id])
  vehicleId            String
  stockNumber          String               @unique
  dealType             DealType
  acquisitionSourceId  String?
  acceptedAt           DateTime?
  expectedArrivalAt    DateTime?
  actualArrivalAt      DateTime?
  departedAt           DateTime?
  currentLocationId    String?
  custodyStatus        CustodyStatus        @default(EXPECTED)
  reconditioningStatus ReconditioningStatus @default(NOT_ASSESSED)
  marketingStatus      MarketingStatus      @default(NOT_READY)
  salesStatus          SalesStatus          @default(AVAILABLE)
  documentStatus       DocStatus            @default(NOT_STARTED)
  financialCloseStatus FinancialCloseStatus @default(ESTIMATING)
  salespersonId        String? // assigned salesperson (User)
  operationsOwnerId    String? // assigned operations owner (User)
  askingPrice          Decimal?             @db.Decimal(12, 2)
  priceReviewAt        DateTime?
  firstListedAt        DateTime?
  active               Boolean              @default(true)
  archivedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  arrangement Arrangement?
  intake      IntakeRecord?

  @@index([vehicleId])
  @@index([active])
  @@index([salesStatus])
}

// Generic append-only status history for every status dimension + prices.
model StatusChange {
  id         String   @id @default(uuid())
  episodeId  String
  dimension  String // "custody" | "reconditioning" | "marketing" | "sales" | "document" | "financial" | "asking_price" | "location"
  fromValue  String?
  toValue    String
  reason     String?
  changedBy  String? // userId
  createdAt  DateTime @default(now())

  @@index([episodeId, dimension])
}

// ---------------------------------------------------------------------------
// Acquisition / consignment arrangement (confidential terms)
// ---------------------------------------------------------------------------

model Arrangement {
  id                      String    @id @default(uuid())
  episode                 InventoryEpisode @relation(fields: [episodeId], references: [id])
  episodeId               String    @unique
  sellerPartyId           String? // seller or consignor
  // Confidential economics — protected by field grants
  purchasePrice           Decimal?  @db.Decimal(12, 2) // dealer purchase
  guaranteedConsignorNet  Decimal?  @db.Decimal(12, 2)
  commissionStructure     Json? // { type: "percent"|"flat"|"markup", value, minimum? }
  reserveAmount           Decimal?  @db.Decimal(12, 2)
  minimumAcceptablePrice  Decimal?  @db.Decimal(12, 2)
  askingPriceAuthority    String?
  priceReductionAuthority String?
  agreementStartAt        DateTime?
  agreementExpiresAt      DateTime?
  renewalTerms            String?
  expenseResponsibility   String? // narrative default; per-expense field is authoritative
  insuranceResponsibility String?
  titleStatus             String? // "present" | "missing" | "lien" | "pending" ...
  lienStatus              String?
  lienholderPartyId       String?
  ownerNotes              String? // owner_notes field grant
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Locations, custody, related items
// ---------------------------------------------------------------------------

model Location {
  id       String  @id @default(uuid())
  key      String  @unique
  name     String
  kind     String // "on_site" | "vendor" | "event" | "transport" | "other"
  address  String?
  active   Boolean @default(true)
}

model VehicleLocationEvent {
  id             String   @id @default(uuid())
  episodeId      String
  fromLocationId String?
  toLocationId   String
  movedById      String?
  reason         String?
  photoFileId    String?
  createdAt      DateTime @default(now())

  @@index([episodeId])
}

enum RelatedItemType {
  KEYS
  TITLE
  REGISTRATION
  SERVICE_RECORDS
  MANUALS
  TOOL_KIT
  SPARE_PARTS
  EXTRA_WHEELS
  REMOVABLE_TOP
  CAR_COVER
  OTHER
}

model RelatedItem {
  id                String          @id @default(uuid())
  episodeId         String
  type              RelatedItemType
  description       String?
  currentLocationId String?
  createdAt         DateTime        @default(now())

  @@index([episodeId])
}

model RelatedItemLocationEvent {
  id             String   @id @default(uuid())
  relatedItemId  String
  fromLocationId String?
  toLocationId   String
  movedById      String?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([relatedItemId])
}

// ---------------------------------------------------------------------------
// Intake (mobile-friendly, draft/resumable)
// ---------------------------------------------------------------------------

model IntakeRecord {
  id                    String    @id @default(uuid())
  episode               InventoryEpisode @relation(fields: [episodeId], references: [id])
  episodeId             String    @unique
  status                String    @default("draft") // draft | complete
  receivedAt            DateTime?
  receivedById          String?
  arrivalMethod         String? // "carrier" | "driven" | "towed" | "other"
  carrierPartyId        String?
  odometerReading       Int?
  mileageStatus         MileageStatus?
  identityVerified      Boolean?
  starts                Boolean?
  runs                  Boolean?
  drives                Boolean?
  stops                 Boolean?
  fuelLevel             String?
  exteriorDamageNotes   String?
  interiorDamageNotes   String?
  glassCondition        String?
  tireCondition         String?
  transportDamageNotes  String?
  sellerReportedIssues  String?
  keysReceived          Int?
  documentsReceived     String?
  accessoriesReceived   String?
  safetyConcerns        String?
  initialLocationId     String?
  notes                 String?
  draftData             Json? // autosaved wizard state
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ===========================================================================
// Phase 3 — workflow: tasks, comments, inspections, work orders, approvals
// ===========================================================================

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id           String       @id @default(uuid())
  episodeId    String?
  title        String
  description  String?
  departmentId String?
  assigneeId   String?
  createdById  String
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  comments Comment[]

  @@index([episodeId])
  @@index([assigneeId, status])
  @@index([departmentId, status])
}

enum CommentVisibility {
  INTERNAL
  VENDOR_VISIBLE
}

// Polymorphic-ish comment: exactly one parent FK set (enforced in service layer).
model Comment {
  id           String            @id @default(uuid())
  episodeId    String?
  taskId       String?
  task         Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workOrderId  String?
  workOrder    WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inspectionId String?
  inspection   Inspection?       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  authorId     String
  authorName   String // denormalized for history
  body         String
  visibility   CommentVisibility @default(INTERNAL)
  createdAt    DateTime          @default(now())

  @@index([episodeId])
  @@index([taskId])
  @@index([workOrderId])
  @@index([inspectionId])
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETE
  CANCELED
}

enum FindingSeverity {
  INFO
  MINOR
  MAJOR
  SAFETY
}

model Inspection {
  id           String           @id @default(uuid())
  episodeId    String
  departmentId String
  assigneeId   String?
  createdById  String
  status       InspectionStatus @default(SCHEDULED)
  summary      String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  findings InspectionFinding[]
  comments Comment[]

  @@index([episodeId])
  @@index([departmentId, status])
  @@index([assigneeId, status])
}

model InspectionFinding {
  id             String          @id @default(uuid())
  inspection     Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId   String
  title          String
  severity       FindingSeverity @default(MINOR)
  description    String?
  recommendation String?
  estimatedCost  Decimal?        @db.Decimal(12, 2)
  workOrderId    String? // set when a work order is created from this finding
  createdAt      DateTime        @default(now())

  @@index([inspectionId])
}

enum WorkOrderStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  DECLINED
  IN_PROGRESS
  QUALITY_CONTROL
  COMPLETE
  CANCELED
}

model WorkOrder {
  id            String          @id @default(uuid())
  episodeId     String
  departmentId  String?
  vendorPartyId String? // external vendor assignment
  assigneeId    String?
  createdById   String
  title         String
  description   String?
  status        WorkOrderStatus @default(DRAFT)
  estimatedCost Decimal?        @db.Decimal(12, 2)
  actualCost    Decimal?        @db.Decimal(12, 2)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  comments  Comment[]
  approvals Approval[]

  @@index([episodeId])
  @@index([departmentId, status])
  @@index([assigneeId, status])
  @@index([vendorPartyId, status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELED
}

model Approval {
  id            String         @id @default(uuid())
  episodeId     String?
  workOrder     WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId   String?
  requestedById String
  approverId    String?
  status        ApprovalStatus @default(PENDING)
  amount        Decimal?       @db.Decimal(12, 2)
  reason        String
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  @@index([status])
  @@index([workOrderId])
}

// ===========================================================================
// Phase 4 — financial ledger and profitability
// ===========================================================================

model ExpenseCategory {
  id     String  @id @default(uuid())
  key    String  @unique
  name   String
  active Boolean @default(true)

  expenses ExpenseEntry[]
}

enum ExpenseStatus {
  ESTIMATED
  SUBMITTED
  APPROVED
  DECLINED
  COMMITTED
  INCURRED
  PAID
  REIMBURSED
  VOIDED
}

enum ExpenseResponsibility {
  DEALERSHIP
  CONSIGNOR
  BUYER_PASS_THROUGH
  SHARED
  REIMBURSABLE
  PENDING
}

model ExpenseEntry {
  id              String                @id @default(uuid())
  episodeId       String
  category        ExpenseCategory       @relation(fields: [categoryId], references: [id])
  categoryId      String
  workOrderId     String? // link to originating work order, if any
  vendorPartyId   String?
  description     String
  status          ExpenseStatus         @default(ESTIMATED)
  responsibility  ExpenseResponsibility @default(DEALERSHIP)
  estimatedAmount Decimal?              @db.Decimal(12, 2)
  approvedAmount  Decimal?              @db.Decimal(12, 2)
  committedAmount Decimal?              @db.Decimal(12, 2)
  actualAmount    Decimal?              @db.Decimal(12, 2)
  paidAt          DateTime?
  receiptFileId   String?
  notes           String?
  createdById     String
  voidedAt        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([episodeId, status])
  @@index([workOrderId])
}

// Immutable snapshot captured at financial close (and on demand for records).
model ProfitSnapshot {
  id                 String   @id @default(uuid())
  episodeId          String   @unique
  revenue            Decimal? @db.Decimal(12, 2) // sale price (projected: asking)
  acquisitionCost    Decimal? @db.Decimal(12, 2)
  dealershipExpenses Decimal  @db.Decimal(12, 2)
  consignorExpenses  Decimal  @db.Decimal(12, 2)
  otherExpenses      Decimal  @db.Decimal(12, 2)
  grossProfit        Decimal? @db.Decimal(12, 2)
  netProfit          Decimal? @db.Decimal(12, 2)
  detail             Json // per-entry breakdown at snapshot time
  computedById       String
  createdAt          DateTime @default(now())
}

// ===========================================================================
// Phase 5 — media, listing readiness, integration outbox
// ===========================================================================

enum MediaKind {
  PHOTO
  VIDEO
  DOCUMENT
}

model MediaAsset {
  id           String    @id @default(uuid())
  episodeId    String
  fileId       String // FileObject id
  kind         MediaKind @default(PHOTO)
  // Category keys match MediaChecklistItem.key so readiness is computable.
  category     String    @default("other")
  caption      String?
  sortOrder    Int       @default(0)
  uploadedById String
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  @@index([episodeId, category])
}

// Configurable media checklist (Administration-editable).
model MediaChecklistItem {
  id        String  @id @default(uuid())
  key       String  @unique // matches MediaAsset.category
  name      String
  required  Boolean @default(true)
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

enum IntegrationEventStatus {
  PENDING
  DELIVERED
  FAILED
}

// Outbox: written in the same transaction as the business change; the listing
// application pulls via authenticated API and acknowledges delivery.
model IntegrationEvent {
  id             String                 @id @default(uuid())
  type           String // e.g. "vehicle.listing_ready", "vehicle.sold"
  episodeId      String?
  payload        Json
  idempotencyKey String                 @unique
  status         IntegrationEventStatus @default(PENDING)
  attempts       Int                    @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime               @default(now())

  @@index([status, createdAt])
  @@index([episodeId])
}

// ===========================================================================
// Phase 6 — sales transactions, payments, documents
// ===========================================================================

enum SaleTxStatus {
  DRAFT
  DEPOSIT_REQUESTED
  DEPOSIT_RECEIVED
  CONTRACTED
  FUNDS_PENDING
  FUNDED
  RELEASED
  DELIVERED
  COMPLETE
  CANCELED
  UNWOUND
}

// One attempted or completed sale on an episode. Canceled/unwound sales are
// preserved; a new SaleTransaction is created for the next buyer.
model SaleTransaction {
  id             String       @id @default(uuid())
  episodeId      String
  buyerPartyId   String
  coBuyerPartyId String?
  salespersonId  String?
  status         SaleTxStatus @default(DRAFT)
  agreedPrice    Decimal      @db.Decimal(12, 2)
  depositAmount  Decimal?     @db.Decimal(12, 2)
  notes          String?
  contractedAt   DateTime?
  releasedAt     DateTime?
  releasedById   String?
  releaseReason  String? // set when an owner override released the gate
  deliveredAt    DateTime?
  canceledAt     DateTime?
  cancelReason   String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payments  Payment[]
  documents DocumentInstance[]

  @@index([episodeId, status])
  @@index([salespersonId])
}

enum PaymentKind {
  DEPOSIT
  DOWN_PAYMENT
  FINAL
  REFUND
}

enum PaymentMethod {
  WIRE
  CHECK
  CASH
  CARD
  FINANCING
  OTHER
}

enum PaymentStatus {
  EXPECTED
  RECEIVED
  CLEARED
  REFUNDED
  FAILED
}

model Payment {
  id           String          @id @default(uuid())
  sale         SaleTransaction @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId       String
  kind         PaymentKind
  method       PaymentMethod
  status       PaymentStatus   @default(EXPECTED)
  amount       Decimal         @db.Decimal(12, 2)
  reference    String? // payment_info field grant
  receivedAt   DateTime?
  clearedAt    DateTime?
  recordedById String
  createdAt    DateTime        @default(now())

  @@index([saleId])
}

// Demonstration document templates — replaced by dealership-approved templates
// per SALES_DOCUMENT_SETUP.md before production use.
model DocumentTemplate {
  id                   String  @id @default(uuid())
  key                  String  @unique
  name                 String
  appliesTo            String  @default("all") // "all" | "DEALER_PURCHASE" | "CONSIGNMENT"
  requiresWetSignature Boolean @default(false)
  active               Boolean @default(true)
  sortOrder            Int     @default(0)

  instances DocumentInstance[]
}

enum DocumentStatus {
  GENERATED
  SENT
  PARTIALLY_SIGNED
  SIGNED
  VOIDED
  FILED
}

model DocumentInstance {
  id                 String           @id @default(uuid())
  episodeId          String
  sale               SaleTransaction? @relation(fields: [saleId], references: [id])
  saleId             String?
  template           DocumentTemplate @relation(fields: [templateId], references: [id])
  templateId         String
  version            Int              @default(1)
  status             DocumentStatus   @default(GENERATED)
  fileId             String // signed_docs sensitivity on the FileObject
  envelopeExternalId String?
  generatedById      String
  sentAt             DateTime?
  signedAt           DateTime?
  filedAt            DateTime?
  createdAt          DateTime         @default(now())

  @@index([episodeId])
  @@index([saleId])
}

// ===========================================================================
// Phase 7 — transport, consignor settlements
// ===========================================================================

enum TransportDirection {
  INBOUND
  OUTBOUND
}

enum TransportStatus {
  QUOTE_REQUESTED
  QUOTED
  BOOKED
  PICKUP_SCHEDULED
  IN_TRANSIT
  DELIVERED
  CANCELED
}

model TransportJob {
  id               String             @id @default(uuid())
  episodeId        String
  saleId           String?
  direction        TransportDirection
  status           TransportStatus    @default(QUOTE_REQUESTED)
  carrierPartyId   String?
  coordinatorId    String? // assigned transport coordinator (User)
  quoteAmount      Decimal?           @db.Decimal(12, 2)
  actualCost       Decimal?           @db.Decimal(12, 2)
  pickupLocation   String?
  deliveryLocation String?
  pickupAt         DateTime?
  deliveredAt      DateTime?
  notes            String?
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([episodeId])
  @@index([status])
  @@index([coordinatorId, status])
}

enum SettlementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

// Consignor payout statement. Computed from the sale, arrangement, and
// consignor-responsibility expense entries; preserved as generated.
model Settlement {
  id               String           @id @default(uuid())
  episodeId        String           @unique
  saleId           String
  consignorPartyId String
  status           SettlementStatus @default(DRAFT)
  salePrice        Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  expenseChargebacks Decimal        @db.Decimal(12, 2)
  netToConsignor   Decimal          @db.Decimal(12, 2)
  dueBy            DateTime?
  detail           Json // line items at generation time
  approvedById     String?
  approvedAt       DateTime?
  paidAt           DateTime?
  reference        String? // banking field grant
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
}

// ===========================================================================
// Phase 8 — notifications
// ===========================================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String?
  href      String? // in-app link
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}
