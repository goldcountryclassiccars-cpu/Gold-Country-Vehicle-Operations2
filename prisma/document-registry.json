    "vehicle.fuelType": "NEW FIELD on Vehicle: GAS|DIESEL|ELECTRIC|OTHER",
    "vehicle.isMotorcycle": "NEW FIELD on Vehicle (or derived from bodyStyle)",
    "episode.dealType": "InventoryEpisode.dealType (DEALER_PURCHASE|CONSIGNMENT|BROKERAGE|OTHER)",
    "arrangement.titleStatus": "Arrangement.titleStatus (present|missing|lien|pending)",
    "arrangement.lienStatus": "Arrangement.lienStatus",
    "arrangement.titleState": "NEW FIELD: two-letter state the current title was issued in",
    "sale.saleDate": "SaleTransaction.contractedAt (date the contract is signed)",
    "sale.agreedPrice": "SaleTransaction.agreedPrice",
    "sale.buyerState": "buyer Party.state",
    "sale.deliveryState": "NEW FIELD on SaleTransaction: state where buyer takes physical possession",
    "sale.deliveryMethod": "NEW FIELD: BUYER_PICKUP|DEALER_DELIVERS|COMMON_CARRIER",
    "sale.registrationState": "NEW FIELD: state the buyer will register in",
    "sale.outsideLender": "NEW FIELD: boolean, buyer using third-party financing",
    "sale.negotiatedLanguage": "NEW FIELD: EN|ES|OTHER",
    "sale.paymentIncludesCashOver10k": "derived from Payment rows: method=CASH and sum >= 10000",
    "sale.hasDueBillItems": "derived: any promised post-sale work/items",
    "sale.hasAddOns": "derived: any optional product/service line items",
    "dealer.*": "static dealer config (AppSetting): legalName, dba, address, dealerLicenseNo, sellersPermitNo"
  },
  "categories": {
    "1": "Dealer-authored: app generates from approved template, e-sign eligible",
    "2": "Government fillable PDF: app prefills, wet signature, print",
    "3": "Controlled DMV document / physical original: app tracks and produces a fill worksheet only",
    "4": "Produced by a third party: app collects, attaches, marks complete"
