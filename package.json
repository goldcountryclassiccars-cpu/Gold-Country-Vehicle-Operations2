{
  "name": "gccc-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Gold Country Classic Cars \u2014 Vehicle Operations Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup": "npm install && npm run db:up && npm run db:migrate && npm run db:seed",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@prisma/client": "^6",
    "@tanstack/react-table": "^8",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "date-fns": "^4",
    "lucide-react": "^0.475.0",
    "next": "^15",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.50",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "prisma": "^6",
    "s3rver": "^3.7.1",
    "tailwindcss": "^4",
    "tsx": "^4.19",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
